---
import { Image, Picture } from 'astro:assets';
import { retailers } from '../lib/content';
import { contacto } from '../lib/contact';
import { foto } from '../lib/images';

const notaHtml = retailers.respaldo.notaHtml.replace(
  '<a data-mail></a>',
  `<a href="${contacto.mailLink}">${contacto.correo}</a>`
);
---

<section id="donde" aria-label="Dónde comprarla" data-oscuro>
  <div class="ni-contenedor rejilla">
    <div class="encabezado">
      <h2 class="ni-h2">{retailers.titulo}</h2>
      <p class="bajada">{retailers.bajada}</p>
    </div>

    <div class="cadenas">
      {
        retailers.cadenas.map((cadena) => (
          <a href={cadena.url} target="_blank" rel="noopener">
            <Image
              src={foto(cadena.logo)}
              alt={cadena.nombre}
              width={300}
              densities={[1, 2]}
              loading="lazy"
              class="logo ni-img-contain"
            />
            <span>{cadena.nombre}</span>
          </a>
        ))
      }
    </div>

    <div class="respaldo">
      <figure>
        <div class="marco-foto" style={`aspect-ratio:${retailers.fotoRatio}`}>
          <Picture
            src={foto(retailers.foto)}
            alt={retailers.fotoAlt}
            formats={['avif', 'webp']}
            widths={[480, 800, 1200, 1400]}
            sizes="(max-width: 800px) 100vw, 50vw"
            loading="lazy"
            class="ni-img"
          />
        </div>
        <figcaption>{retailers.fotoPie}</figcaption>
      </figure>
      <div class="contacto">
        <p class="pregunta">{retailers.respaldo.pregunta}</p>
        <a class="ni-boton ni-boton--blanco" href={contacto.waLink}>
          <span class="ni-punto-wa"></span>{retailers.respaldo.boton}
        </a>
        <p class="nota" set:html={notaHtml} />
      </div>
    </div>
  </div>
</section>

<style>
  section {
    background: var(--ni-rojo);
    color: #fff;
  }
  .rejilla {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: clamp(28px, 4vw, 56px);
    align-items: center;
  }
  .encabezado {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    gap: clamp(14px, 1.8vw, 22px);
    align-items: flex-start;
    max-width: 60ch;
  }
  .encabezado .ni-h2 {
    font-size: clamp(34px, 5vw, 68px);
    color: #fff;
  }
  .bajada {
    margin: 0;
    font: 400 clamp(15px, 1.4vw, 19px) / 1.65 'Arimo', sans-serif;
    color: rgba(255, 255, 255, 0.92);
  }
  .cadenas {
    grid-column: 1 / -1;
    display: grid;
    /* Piso de 148px: permite las 5 columnas al ancho de contenido de 1072px */
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 148px), 1fr));
    gap: clamp(12px, 1.6vw, 18px);
  }
  .cadenas a {
    background: #fff;
    border-radius: var(--ni-radio-foto);
    padding: clamp(18px, 2vw, 26px);
    display: flex;
    flex-direction: column;
    gap: 14px;
    align-items: center;
    text-align: center;
    transition: transform var(--ni-transicion), box-shadow var(--ni-transicion);
  }
  .cadenas a:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 26px rgba(0, 0, 0, 0.24);
  }
  .cadenas :global(.logo) {
    position: static;
    display: block;
    width: 100%;
    max-width: 150px;
    height: 74px;
    object-fit: contain;
  }
  .cadenas span {
    font: 700 clamp(13px, 1.25vw, 14.5px) / 1.3 'Arimo', sans-serif;
    color: var(--ni-negro);
  }
  .respaldo {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: clamp(20px, 3vw, 44px);
    align-items: center;
    padding-top: clamp(10px, 1.4vw, 18px);
  }
  figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .marco-foto {
    width: 100%;
    border-radius: var(--ni-radio-foto);
    overflow: hidden;
  }
  figcaption {
    font: 400 var(--ni-menor) / 1.6 'Arimo', sans-serif;
    color: rgba(255, 255, 255, 0.85);
  }
  .contacto {
    display: flex;
    flex-direction: column;
    gap: 14px;
    align-items: flex-start;
  }
  .pregunta {
    margin: 0;
    font: 400 clamp(14px, 1.35vw, 16px) / 1.65 'Arimo', sans-serif;
    color: rgba(255, 255, 255, 0.92);
  }
  .contacto .ni-boton {
    padding: 18px 28px;
    font-size: clamp(14px, 1.35vw, 17px);
  }
  .nota {
    margin: 0;
    font: 400 var(--ni-menor) / 1.6 'Arimo', sans-serif;
    color: #fff;
  }
  .nota :global(a) {
    color: #fff;
    border-bottom: 1px solid rgba(255, 255, 255, 0.6);
  }
</style>
