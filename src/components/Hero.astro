---
import { Picture } from 'astro:assets';
import { hero, site } from '../lib/content';
import { foto } from '../lib/images';
---

<section id="top" aria-label="Presentación" data-oscuro>
  <div class="rejilla">
    <div class="panel">
      <span class="badge">{hero.badge}</span>
      <h1>{hero.titulo}</h1>
      <p class="bajada" set:html={hero.bajadaHtml} />
      <div class="ctas">
        <a class="ni-boton ni-boton--rojo cta-principal" href={hero.ctaPrimario.href}>
          {hero.ctaPrimario.texto}
        </a>
        <a class="ni-boton ni-boton--contorno-claro cta-secundario" href={hero.ctaSecundario.href}>
          {hero.ctaSecundario.texto}
        </a>
      </div>
      <div class="chips">
        {
          hero.chips.map((chip) => (
            <span class:list={['chip', { verde: chip.verde }]}>{chip.texto}</span>
          ))
        }
      </div>
    </div>
    <div class="foto" style={`aspect-ratio:${hero.fotoRatio}`}>
      <Picture
        src={foto(hero.foto)}
        alt={hero.fotoAlt}
        formats={['avif', 'webp']}
        widths={[480, 800, 1200, 1400]}
        sizes="(max-width: 800px) 100vw, 50vw"
        loading="eager"
        fetchpriority="high"
        class="ni-img-cover"
      />
      {
        site.mostrarNieve && (
          <>
            <span class="copo" style="left:16%;width:5px;height:5px;animation-duration:9s" />
            <span class="copo" style="left:44%;width:4px;height:4px;animation-duration:12s;animation-delay:2.5s" />
            <span class="copo" style="left:68%;width:6px;height:6px;animation-duration:10.5s;animation-delay:4s" />
            <span class="copo" style="left:88%;width:4px;height:4px;animation-duration:11s;animation-delay:6.5s" />
          </>
        )
      }
    </div>
  </div>
</section>

<style>
  section {
    background: var(--ni-negro);
  }
  .rejilla {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
  }
  .panel {
    padding: clamp(36px, 5vw, 80px) var(--ni-margen) clamp(32px, 4.5vw, 72px);
    display: flex;
    flex-direction: column;
    gap: clamp(16px, 2vw, 26px);
    align-items: flex-start;
    justify-content: center;
  }
  .badge {
    padding: 7px 12px;
    border-radius: 5px;
    background: rgba(255, 255, 255, 0.14);
    color: #fff;
    font: 700 var(--ni-etiqueta) / 1 'Arimo', sans-serif;
    letter-spacing: 0.1em;
  }
  h1 {
    margin: 0;
    font: 400 var(--ni-display-1) / 1.06 'Sunday', cursive;
    color: #fff;
    max-width: 14ch;
    text-wrap: balance;
  }
  .bajada {
    margin: 0;
    font: 400 var(--ni-cuerpo-lg) / 1.6 'Arimo', sans-serif;
    color: rgba(255, 255, 255, 0.88);
    max-width: 42ch;
  }
  .bajada :global(strong) {
    font-weight: 700;
    color: #fff;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    width: 100%;
    max-width: 480px;
  }
  .cta-principal {
    flex: 1 1 210px;
  }
  .cta-secundario {
    flex: 1 1 150px;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }
  .chip {
    padding: 6px 11px;
    border-radius: var(--ni-radio-chip);
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    font: 700 clamp(10px, 1vw, 11.5px) / 1 'Arimo', sans-serif;
    letter-spacing: 0.05em;
  }
  .chip.verde {
    background: var(--ni-verde);
  }
  .foto {
    position: relative;
    overflow: hidden;
    align-self: center;
    width: 100%;
  }
  .copo {
    position: absolute;
    top: 0;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 4px rgba(17, 18, 19, 0.35);
    animation: ni-fall linear infinite;
  }
</style>
