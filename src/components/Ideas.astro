---
import { Picture } from 'astro:assets';
import { ideas } from '../lib/content';
import { contacto } from '../lib/contact';
import { foto } from '../lib/images';

const notaHtml = ideas.notaHtml.replace('<a data-wa>', `<a href="${contacto.waLink}">`);
---

<section id="ideas" aria-label="Ideas para decorar" data-oscuro>
  <div class="ni-contenedor columna">
    <div class="encabezado">
      <span class="ni-eyebrow claro">{ideas.eyebrow}</span>
      <h2 class="ni-h2">{ideas.titulo}</h2>
    </div>
    <div class="rejilla">
      {
        ideas.ideas.map((idea) => (
          <article>
            <div class="marco-foto">
              <Picture
                src={foto(idea.foto)}
                alt={idea.fotoAlt}
                formats={['avif', 'webp']}
                widths={[400, 700, 1000]}
                sizes="(max-width: 640px) 100vw, (max-width: 1100px) 50vw, 25vw"
                loading="lazy"
                class="ni-img-cover"
                style={idea.fotoPosicion ? `object-position:${idea.fotoPosicion}` : undefined}
              />
            </div>
            <div class="cuerpo">
              {idea.chip && (
                <div class="chip-fila">
                  <span class="chip">{idea.chip}</span>
                </div>
              )}
              <h3>{idea.titulo}</h3>
              <p set:html={idea.textoHtml} />
            </div>
          </article>
        ))
      }
    </div>
    <p class="nota" set:html={notaHtml} />
  </div>
</section>

<style>
  section {
    background: var(--ni-negro);
    color: #fff;
  }
  .columna {
    display: flex;
    flex-direction: column;
    gap: clamp(24px, 3vw, 40px);
  }
  .encabezado {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 60ch;
  }
  .ni-eyebrow.claro {
    color: var(--ni-rojo-claro);
  }
  .rejilla {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: clamp(14px, 1.8vw, 24px);
  }
  article {
    background: rgba(255, 255, 255, 0.06);
    border-radius: var(--ni-radio-foto);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .marco-foto {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
  }
  .cuerpo {
    padding: clamp(15px, 1.8vw, 20px);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .chip-fila {
    display: flex;
  }
  .chip {
    padding: 4px 8px;
    border-radius: var(--ni-radio-chip);
    background: var(--ni-azul);
    color: #fff;
    font: 700 9.5px/1 'Arimo', sans-serif;
    letter-spacing: 0.08em;
  }
  h3 {
    margin: 0;
    font: 700 clamp(15.5px, 1.5vw, 18px) / 1.3 'Arimo', sans-serif;
    color: #fff;
  }
  .cuerpo p {
    margin: 0;
    font: 400 clamp(13px, 1.25vw, 14.5px) / 1.6 'Arimo', sans-serif;
    color: rgba(255, 255, 255, 0.72);
  }
  .cuerpo p :global(a) {
    color: #fff;
    border-bottom: 1px solid rgba(255, 255, 255, 0.5);
  }
  .nota {
    margin: 0;
    font: 400 var(--ni-menor) / 1.6 'Arimo', sans-serif;
    color: rgba(255, 255, 255, 0.55);
  }
  .nota :global(a) {
    color: #fff;
    border-bottom: 1px solid rgba(255, 255, 255, 0.5);
  }
</style>
