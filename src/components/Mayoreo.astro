---
import { mayoreo } from '../lib/content';
import { contacto } from '../lib/contact';
---

<section id="mayoreo" aria-label="Mayoreo" data-oscuro>
  <div class="contenedor">
    <div class="columna">
      <span class="ni-eyebrow claro">{mayoreo.eyebrow}</span>
      <h2>{mayoreo.titulo}</h2>
      <p>{mayoreo.texto}</p>
    </div>
    <div class="botones">
      <a class="ni-boton ni-boton--rojo" href={contacto.waMayoreoLink}>
        <span class="ni-punto-wa ni-punto-wa--claro"></span>{mayoreo.botonCotizar}
      </a>
      <a class="ni-boton ni-boton--contorno-claro" href={contacto.telLink}>
        {mayoreo.botonLlamar}
        {contacto.whatsapp}
      </a>
    </div>
  </div>
</section>

<style>
  section {
    background: var(--ni-negro);
    color: #fff;
  }
  .contenedor {
    max-width: var(--ni-ancho-max);
    margin: 0 auto;
    padding: clamp(44px, 6vw, 88px) var(--ni-margen);
    display: flex;
    flex-wrap: wrap;
    gap: clamp(22px, 3vw, 44px);
    align-items: center;
    justify-content: space-between;
  }
  .columna {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 52ch;
  }
  .ni-eyebrow.claro {
    color: var(--ni-rojo-claro);
  }
  h2 {
    margin: 0;
    font: 400 clamp(30px, 4vw, 54px) / 1.02 'Sunday', cursive;
    color: #fff;
  }
  p {
    margin: 0;
    font: 400 clamp(14.5px, 1.35vw, 17px) / 1.65 'Arimo', sans-serif;
    color: rgba(255, 255, 255, 0.78);
  }
  .botones {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .botones .ni-boton {
    padding: 17px 26px;
    font-size: clamp(14px, 1.3vw, 16px);
  }
</style>
