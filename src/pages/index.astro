---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Como from '../components/Como.astro';
import Productos from '../components/Productos.astro';
import Ideas from '../components/Ideas.astro';
import Donde from '../components/Donde.astro';
import Preguntas from '../components/Preguntas.astro';
import Nosotros from '../components/Nosotros.astro';
import Mayoreo from '../components/Mayoreo.astro';
import Footer from '../components/Footer.astro';
---

<Base>
  <div class="ni-envoltura">
    <Header />
    <main>
      <Hero />
      <Como />
      <Productos />
      <Ideas />
      <Donde />
      <Preguntas />
      <Nosotros />
      <Mayoreo />
    </main>
    <Footer />
  </div>
</Base>
